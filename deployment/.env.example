# Copy to .env and adjust. Used by deployment/compose.yml.
# Password for the MariaDB root user and the Frappe "Administrator" account.
DB_ROOT_PASSWORD=change-me-db
ADMIN_PASSWORD=change-me-admin
# Optional: shared token the React app sends to the BFF (must match bff/.env BFF_API_TOKEN).
# Leave empty for local development (open BFF).
VITE_BFF_TOKEN=
